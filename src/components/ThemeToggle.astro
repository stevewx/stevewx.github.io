---
/**
 * Light/dark toggle. Shows a moon in light mode (click → dark) and a sun in
 * dark mode (click → light); the visible glyph is chosen purely in CSS (see
 * global.css .icon-to-*), so it is correct before JS runs — no flash.
 *
 * On click it resolves the *currently rendered* theme (explicit class first,
 * else the OS preference), flips to the opposite, persists it, and broadcasts
 * a `themechange` event so other listeners (e.g. the canvas FX) can react.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  class:list={[
    "inline-flex h-9 w-9 items-center justify-center rounded-md text-slate-400 transition-colors hover:bg-ink-800 hover:text-slate-100",
    className,
  ]}
  aria-label="Toggle color theme"
  title="Toggle light / dark"
>
  <!-- moon: shown in light mode → clicking switches to dark -->
  <svg
    class="icon-to-dark h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <!-- sun: shown in dark mode → clicking switches to light -->
  <svg
    class="icon-to-light h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    const prefersDark = () =>
      window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: dark)").matches;

    const current = () => {
      const c = document.documentElement.classList;
      if (c.contains("dark")) return "dark";
      if (c.contains("light")) return "light";
      return prefersDark() ? "dark" : "light";
    };

    btn.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      const root = document.documentElement;
      root.classList.remove("light", "dark");
      root.classList.add(next);
      try {
        localStorage.setItem("theme", next);
      } catch (_) {
        /* ignore persistence failure */
      }
      window.dispatchEvent(
        new CustomEvent("themechange", { detail: { theme: next } }),
      );
    });
  })();
</script>
