---
/**
 * About page body, locale-aware. Detects the active locale from the URL and
 * pulls copy from the i18n dictionary (ui.ts) and structured data (about-data).
 * Rendered by both /about (en) and /zh/about (zh).
 */
import { SOCIALS } from "../../consts";
import { getLocaleFromPath } from "../../i18n/config";
import { t } from "../../i18n/ui";
import { ABOUT } from "../../i18n/about-data";

const locale = getLocaleFromPath(Astro.url.pathname);
const s = t(locale);
const data = ABOUT[locale];
const socials = SOCIALS.filter((soc) => soc.show);

const socialLabel: Record<string, string> = {
  GitHub: s.socials.github,
  LinkedIn: s.socials.linkedin,
};

---

<div class="mx-auto max-w-3xl px-5 py-16">
  <p class="kicker mb-3">{s.about.kicker}</p>
  <h1 class="text-3xl font-bold text-slate-50 sm:text-4xl">
    {s.about.title}
  </h1>

  <div class="mt-6 space-y-4 text-slate-300 leading-relaxed">
    <p>{s.about.p1}</p>
    <p>{s.about.p2}</p>
    <p>{s.about.p3}</p>
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    {
      socials.map((soc) => (
        <a
          href={soc.href}
          class="rounded-md border border-ink-700 px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-accent-dim hover:text-accent"
          target={soc.href.startsWith("http") ? "_blank" : undefined}
          rel={soc.href.startsWith("http") ? "noopener noreferrer" : undefined}
        >
          {socialLabel[soc.label] ?? soc.label}
        </a>
      ))
    }
  </div>

  <!-- Skills -->
  <section class="mt-16">
    <p class="kicker mb-4">{s.about.skillsKicker}</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        data.skillGroups.map((g) => (
          <div class="card p-5">
            <h3 class="font-mono text-sm text-accent-muted">{g.group}</h3>
            <ul class="mt-3 space-y-1.5">
              {g.items.map((it) => (
                <li class="text-sm text-slate-300">{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected work -->
  <section class="mt-16">
    <p class="kicker mb-4">{s.about.workKicker}</p>
    <ol class="relative space-y-8 border-l border-ink-700 pl-6">
      {
        data.work.map((w) => (
          <li class="relative">
            <span
              class="absolute -left-[1.65rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-accent bg-ink-950"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold text-slate-100">{w.role}</h3>
              <span class="font-mono text-xs text-slate-500">{w.period}</span>
            </div>
            <p class="font-mono text-xs text-accent-muted">{w.org}</p>
            <p class="mt-2 text-sm text-slate-400">{w.summary}</p>

            {w.stats.length > 0 && (
              <dl class="mt-4 flex flex-wrap gap-2">
                {w.stats.map((st) => (
                  <div class="rounded-md border border-ink-700 bg-ink-850 px-3 py-1.5">
                    <dt class="font-mono text-base font-semibold leading-none text-accent">
                      {st.value}
                    </dt>
                    <dd class="mt-1 text-[11px] leading-tight text-slate-500">
                      {st.label}
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            {w.points.length > 0 && (
              <ul class="mt-4 space-y-1.5">
                {w.points.map((p) => (
                  <li class="flex gap-2 text-sm text-slate-300">
                    <span class="text-accent-muted">▸</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Education -->
  <section class="mt-16">
    <p class="kicker mb-4">{s.about.eduKicker}</p>
    <div class="space-y-3">
      {
        data.education.map((e) => (
          <div class="card p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold text-slate-100">{e.school}</h3>
              <span class="font-mono text-xs text-slate-500">{e.period}</span>
            </div>
            <p class="mt-1 text-sm text-slate-400">{e.detail}</p>
          </div>
        ))
      }
    </div>
  </section>
</div>
