---
import { SOCIALS } from "../consts";
import FxBackground from "./FxBackground.astro";
import { getLocaleFromPath, localizePath } from "../i18n/config";
import { t } from "../i18n/ui";

const locale = getLocaleFromPath(Astro.url.pathname);
const s = t(locale);
const socials = SOCIALS.filter((soc) => soc.show);

const socialLabel: Record<string, string> = {
  GitHub: s.socials.github,
  LinkedIn: s.socials.linkedin,
};
---

<section class="relative flex min-h-[34rem] flex-1 flex-col overflow-hidden">
  <!-- Randomized training-themed canvas (bottom layer) -->
  <FxBackground />
  <div
    class="grid-dots pointer-events-none absolute inset-0 opacity-40"
    aria-hidden="true"
  >
  </div>
  <!-- Fade the FX out into the page background toward the bottom -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-b from-transparent to-ink-950"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto max-w-5xl px-5 pb-16 pt-20 sm:pt-28"
    data-hero-content
  >
    <p class="kicker mb-4 animate-fade-up">
      <span class="text-slate-500">$</span>
      {s.hero.whoami}
    </p>

    <h1
      class="animate-fade-up text-4xl font-bold leading-[1.05] text-slate-50 sm:text-6xl"
      style="animation-delay: 60ms"
    >
      {s.site.name}
    </h1>

    <p
      class="mt-5 max-w-2xl animate-fade-up text-lg leading-relaxed text-slate-300 sm:text-xl"
      style="animation-delay: 120ms"
    >
      {s.hero.leadPre}<span class="text-accent">{s.hero.roleEmph}</span>{
        s.hero.leadMid
      }<span class="text-slate-100">{s.hero.topicEmph}</span>{s.hero.leadPost}<span
        class="text-slate-100">{s.hero.fastEmph}</span
      >{s.hero.and}<span class="text-slate-100">{s.hero.reliableEmph}</span>{
        s.hero.leadEnd
      }
    </p>

    <p
      class="mt-3 max-w-2xl animate-fade-up font-mono text-sm text-slate-500"
      style="animation-delay: 160ms"
    >
      {s.hero.recently}
    </p>

    <p
      class="mt-6 max-w-2xl animate-fade-up text-sm leading-relaxed text-slate-400"
      style="animation-delay: 200ms"
    >
      {s.hero.maintainedBy}
    </p>

    <div
      class="mt-6 flex animate-fade-up flex-wrap items-center gap-3"
      style="animation-delay: 260ms"
    >
      <a
        href={localizePath("/blog", locale)}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-ink-950 transition-colors hover:bg-accent-muted"
      >
        {s.hero.readBlog}
      </a>
      <a
        href={localizePath("/about", locale)}
        class="rounded-md border border-ink-700 px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-accent-dim hover:text-accent"
      >
        {s.hero.aboutMe}
      </a>
      <div class="ml-1 flex items-center gap-4">
        {
          socials.map((soc) => (
            <a
              href={soc.href}
              class="font-mono text-xs text-slate-500 hover:text-accent"
              target={soc.href.startsWith("http") ? "_blank" : undefined}
              rel={
                soc.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
            >
              {socialLabel[soc.label] ?? soc.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
