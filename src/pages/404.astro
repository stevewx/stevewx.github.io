---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";

const s = t("en");
---

<BaseLayout title={s.notFound.metaTitle}>
  <div class="mx-auto flex max-w-3xl flex-col items-start px-5 py-32">
    <p class="font-mono text-sm text-signal">{s.notFound.cmd}</p>
    <h1 class="mt-4 text-5xl font-bold text-slate-50">{s.notFound.title}</h1>
    <p class="mt-3 text-slate-400">{s.notFound.body}</p>
    <a
      href="/"
      class="mt-8 rounded-md border border-ink-700 px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-accent-dim hover:text-accent"
    >
      {s.notFound.back}
    </a>
  </div>
</BaseLayout>
